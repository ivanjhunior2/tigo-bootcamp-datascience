# Copiar a .env y ajustar si hace falta. .env nunca se commitea (ver .gitignore).

# --- Postgres: instancia unica, base de datos "warehouse" para bronze/silver/gold ---
POSTGRES_USER=dataeng
POSTGRES_PASSWORD=dataeng_pw
POSTGRES_DB=warehouse
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Nombre de la base de datos de metadata de Airflow (misma instancia de Postgres,
# la crea docker/postgres/init/01-init-databases.sh en el primer arranque)
AIRFLOW_DB=airflow

# --- Airflow ---
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_ADMIN_FIRSTNAME=Admin
AIRFLOW_ADMIN_LASTNAME=User
AIRFLOW_ADMIN_EMAIL=admin@example.com

# --- Warehouse: usado por src/ (ingesta, validacion) para conectarse a Postgres ---
WAREHOUSE_HOST=postgres
WAREHOUSE_PORT=5432
WAREHOUSE_DB=warehouse
WAREHOUSE_USER=dataeng
WAREHOUSE_PASSWORD=dataeng_pw

# --- Datos crudos dentro de los contenedores ---
DATA_ROOT=/opt/airflow/data
